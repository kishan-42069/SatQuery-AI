# SatQuery AI — Environment Variables Template
# Copy this file to .env and fill in your values before running.
# NEVER commit your actual .env file to version control.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=satquery
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=satquery_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://satquery:your_secure_password_here@db:5432/satquery_db

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE
# ⚠️  IMPORTANT: This is where all satellite imagery and derived products live.
# For MVP: local filesystem. For production: swap to S3-compatible storage.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local          # Options: local | s3
STORAGE_LOCAL_ROOT=./data      # Root path for local file storage
# S3_BUCKET_NAME=your-bucket
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# ── MODEL INJECTION POINT ────────────────────────────────────────────────────
# Set the VLM checkpoint name here when you decide on the model.
# Example values:
#   Salesforce/blip2-opt-2.7b
#   llava-hf/llava-1.5-7b-hf
# The model loader will read this variable at startup.
# ─────────────────────────────────────────────────────────────────────────────
VLM_MODEL_NAME=PLACEHOLDER_SET_WHEN_MODEL_IS_CHOSEN
VLM_DEVICE=cpu                 # Options: cpu | cuda | mps

# ─────────────────────────────────────────────────────────────────────────────
# ── LLM / ORCHESTRATOR INJECTION POINT ───────────────────────────────────────
# GPT-4o is the default (best production results for agentic tasks).
# Set your OpenAI API key here when provided.
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # Options: openai | gemini | ollama
LLM_MODEL=gpt-4o
OPENAI_API_KEY=PLACEHOLDER_API_KEY_TO_BE_PROVIDED
# GOOGLE_API_KEY=PLACEHOLDER_API_KEY_TO_BE_PROVIDED
# OLLAMA_BASE_URL=http://localhost:11434

# ── GEMINI VLM (Specialist Agents — Option A integration) ──────────────────────
# Used by GeminiVisionClient in app/ai/gemini_client.py for image analysis.
# If not set, the system operates in offline/heuristic mode automatically.
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development            # Options: development | production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
ALLOWED_IMAGE_FORMATS=tif,tiff,jp2,img,hdf5,nc,png,jpg,jpeg
