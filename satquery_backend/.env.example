# SatQuery AI - Environment Configuration
# SIH 2026 Problem Statement 26167 (ISRO)

# Google Gemini API Key for VLM / Vision-Language reasoning
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Maximum file upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE=104857600

# Storage directory for uploaded GeoTIFFs and derived RGB previews
STORAGE_DIR=./storage

# Database connection URL (SQLite or PostgreSQL / PostGIS)
# Default is local SQLite for reliable zero-config demo execution
DATABASE_URL=sqlite+aiosqlite:///./storage/satquery.db
